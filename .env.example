# postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=secret-password
POSTGRES_DB=inbox-zero-db
POSTGRES_URL=postgresql+psycopg://user:secret-password@localhost:5432/inbox-zero-db

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# google config 
GOOGLE_CLIENT_ID=change-me-please
GOOGLE_CLIENT_SECRET=change-me-please
GOOGLE_PROJECT_ID=change-me-please
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs   
GOOGLE_REDIRECT_URIS=["http://localhost:8000/auth/google/callback"]
GOOGLE_JAVASCRIPT_ORIGINS=["http://localhost:3000"]
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SCOPES=["openid", "https://www.googleapis.com/auth/userinfo.email", "https://www.googleapis.com/auth/gmail.modify"]
GOOGLE_STATE_SECRET=change-me-please
GOOGLE_STATE_EXPIRE_SECONDS=600
GOOGLE_REFRESH_TOKEN_SECRET=change-me-please

# app
ENVIRONMENT=development
CORS=["http://localhost:3000"]
ALGORITHM=HS256
SECRET_KEY=change-me-please
AUDIENCE=["http://localhost:3000"]
